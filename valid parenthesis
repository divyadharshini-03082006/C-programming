#include <stdbool.h>
#include <string.h>
bool isValid(char* s) {
    int len = strlen(s);
    if (len % 2 != 0) return false;
    char stack[len];
    int top = -1;
    for (int i = 0; i < len; i++) {
        char c = s[i];
        if (c == '(') {
            stack[++top] = ')';
        } else if (c == '{') {
            stack[++top] = '}';
        } else if (c == '[') {
            stack[++top] = ']';
        } 
        else {
            if (top == -1 || stack[top] != c) {
                return false;
            }
            top--; 
        }
    }
    return top == -1;
}
