#include <string.h>
char* longestPalindrome(char* s) {
    int len = strlen(s);
    if (len < 2) return s;
    int start = 0, max_len = 1;
    for (int i = 0; i < len; i++) {
        int l = i, r = i;
        while (l >= 0 && r < len && s[l] == s[r]) {
            if (r - l + 1 > max_len) {
                start = l;
                max_len = r - l + 1;
            }
            l--; r++;
        }
        l = i, r = i + 1;
        while (l >= 0 && r < len && s[l] == s[r]) {
            if (r - l + 1 > max_len) {
                start = l;
                max_len = r - l + 1;
            }
            l--; r++;
        }
    }
    s[start + max_len] = '\0';
    return s + start;
}
