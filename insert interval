#include <stdio.h>
#include <stdlib.h>
int** insert(int** intervals, int intervalsSize, int* intervalsColSize, 
             int* newInterval, int newIntervalSize, int* returnSize, int** returnColumnSizes) {
    int** res = malloc((intervalsSize + 1) * sizeof(int*));
    *returnColumnSizes = malloc((intervalsSize + 1) * sizeof(int*));
    *returnSize = 0;
    int i = 0;
    int targetStart = newInterval[0];
    int targetEnd = newInterval[1];
    while (i < intervalsSize && intervals[i][1] < targetStart) {
        res[*returnSize] = malloc(2 * sizeof(int));
        res[*returnSize][0] = intervals[i][0];
        res[*returnSize][1] = intervals[i][1];
        (*returnColumnSizes)[*returnSize] = 2;
        (*returnSize)++;
        i++;
    }
    while (i < intervalsSize && intervals[i][0] <= targetEnd) {
        if (intervals[i][0] < targetStart) {
            targetStart = intervals[i][0];
        }
        if (intervals[i][1] > targetEnd) {
            targetEnd = intervals[i][1];
        }
        i++;
    }
    res[*returnSize] = malloc(2 * sizeof(int));
    res[*returnSize][0] = targetStart;
    res[*returnSize][1] = targetEnd;
    (*returnColumnSizes)[*returnSize] = 2;
    (*returnSize)++;
    while (i < intervalsSize) {
        res[*returnSize] = malloc(2 * sizeof(int));
        res[*returnSize][0] = intervals[i][0];
        res[*returnSize][1] = intervals[i][1];
        (*returnColumnSizes)[*returnSize] = 2;
        (*returnSize)++;
        i++;
    }
    return res;
}
