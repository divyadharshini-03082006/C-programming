#include <stdlib.h>
#include <string.h>

int cmp(const void* a, const void* b) { 
    return *(int*)a - *(int*)b; 
}
void backtrack(int* c, int n, int target, int start, int* path, int pathSz, int** r, int* rSz, int* cs) {
    if (target == 0) {
        r[*rSz] = malloc(pathSz * sizeof(int));
        memcpy(r[*rSz], path, pathSz * sizeof(int));
        cs[(*rSz)++] = pathSz;
        return;
    }
    for (int i = start; i < n; i++) {
        if (c[i] > target) break; 
        if (i > start && c[i] == c[i-1]) continue;
        
        path[pathSz] = c[i];
        backtrack(c, n, target - c[i], i + 1, path, pathSz + 1, r, rSz, cs);
    }
}
int** combinationSum2(int* candidates, int candidatesSize, int target, int* returnSize, int** returnColumnSizes) {
    qsort(candidates, candidatesSize, sizeof(int), cmp);
    int max_combos = 2000; 
    int** result = malloc(max_combos * sizeof(int*));
    *returnColumnSizes = malloc(max_combos * sizeof(int));
    *returnSize = 0;
    int* path = malloc(target * sizeof(int));
    backtrack(candidates, candidatesSize, target, 0, path, 0, result, returnSize, *returnColumnSizes);
    free(path);
    return result;
}
